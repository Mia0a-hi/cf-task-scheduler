# Cloudflare Worker Configuration Example
name = "cf-task-scheduler"
main = "src/index.js"
compatibility_date = "2024-04-05"
compatibility_flags = ["nodejs_compat"]

# Cloudflare Cron Triggers: trigger scheduler once every minute
[triggers]
crons = ["* * * * *"]

# Cloudflare D1 Database Binding
[[d1_databases]]
binding = "DB"
database_name = "task_db"
database_id = "your-database-id-from-wrangler-d1-create"

[vars]
TIMEZONE = "Asia/Shanghai"
MAX_LOG_RETENTION_DAYS = "30"
